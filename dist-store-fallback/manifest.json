{
  "manifest_version": 3,
  "name": "Screencappy - Full Page Screenshot",
  "version": "0.1.0",
  "description": "One-click full page screenshots. Annotate, redact and export as PNG, JPEG, WebP or PDF. Nothing leaves your device.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://screencappy.smollet.app",
  "offline_enabled": true,
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Screencappy - capture full page (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "contextMenus",
    "unlimitedStorage"
  ],
  "commands": {
    "capture-full": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Capture full page"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Capture visible area"
    },
    "capture-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture a selected region"
    },
    "capture-element": {
      "description": "Capture an element"
    }
  }
}