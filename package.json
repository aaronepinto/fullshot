{
  "name": "screencappy",
  "version": "0.2.0",
  "description": "screencappy · one-click full page screenshots. Capture, annotate, export. Private by design.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/gen-icons.mjs && node build.mjs",
    "build:firefox": "node scripts/gen-icons.mjs && node build.mjs --target=firefox",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "icons": "node scripts/gen-icons.mjs",
    "zip": "npm run build && node build.mjs --zip",
    "zip:firefox": "npm run build:firefox && node build.mjs --target=firefox --zip",
    "e2e": "node tests/e2e.mjs",
    "e2e:firefox": "node tests/e2e-firefox.mjs",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "test": "bun test tests/unit --coverage",
    "test:ux": "npm run build && playwright test",
    "build:store-fallback": "node scripts/gen-icons.mjs && node build.mjs --target=store-fallback"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "@types/chrome": "latest",
    "@types/selenium-webdriver": "^4.35.6",
    "esbuild": "latest",
    "puppeteer-core": "^25.7.0",
    "selenium-webdriver": "^4.47.0",
    "typescript": "latest",
    "web-ext": "^10.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smollet-app/screencappy.git"
  },
  "homepage": "https://screencappy.smollet.app",
  "license": "Apache-2.0"
}
